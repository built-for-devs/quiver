[
 {
  "name": "action_proposal",
  "inputSchema": {
   "type": "object",
   "properties": {
    "log_id": {
     "type": "string",
     "description": "Performance log ID containing the proposal"
    },
    "action": {
     "type": "string",
     "enum": [
      "approved",
      "rejected"
     ],
     "description": "Action to take"
    },
    "modified_updates": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "field": {
        "type": "string"
       },
       "current": {
        "type": "string"
       },
       "proposed": {},
       "rationale": {
        "type": "string"
       }
      },
      "required": [
       "field",
       "current",
       "rationale"
      ],
      "additionalProperties": false
     },
     "description": "Optional: modify proposals before approving"
    }
   },
   "required": [
    "log_id",
    "action"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  }
 },
 {
  "name": "add_competitor",
  "inputSchema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "description": "Competitor name"
    },
    "homepage_url": {
     "type": "string",
     "description": "Public https URL of their homepage"
    },
    "pages": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "surface": {
        "type": "string",
        "enum": [
         "homepage",
         "pricing",
         "product",
         "changelog",
         "blog",
         "reviews",
         "careers",
         "profile",
         "docs",
         "github",
         "social"
        ],
        "description": "Which surface this page is"
       },
       "url": {
        "type": "string",
        "description": "Public https URL of the page"
       }
      },
      "required": [
       "surface",
       "url"
      ],
      "additionalProperties": false
     },
     "description": "Specific pages to watch. Omit to auto-discover from the homepage."
    }
   },
   "required": [
    "name",
    "homepage_url"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  }
 },
 {
  "name": "add_distribution",
  "inputSchema": {
   "type": "object",
   "properties": {
    "content_id": {
     "type": "string",
     "description": "Content piece ID"
    },
    "slug": {
     "type": "string",
     "description": "Content piece slug"
    },
    "channel": {
     "type": "string",
     "description": "Distribution channel (website, dev_to, hashnode, medium, newsletter, linkedin, twitter, youtube, other)"
    },
    "url": {
     "type": "string",
     "description": "The URL where the content went live (required)"
    },
    "status": {
     "type": "string",
     "default": "planned",
     "description": "Distribution status"
    },
    "notes": {
     "type": "string",
     "description": "Notes"
    }
   },
   "required": [
    "channel",
    "url"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  }
 },
 {
  "name": "apply_context_update",
  "inputSchema": {
   "type": "object",
   "properties": {
    "updates": {
     "type": "object",
     "additionalProperties": {},
     "propertyNames": {
      "enum": [
       "positioningStatement",
       "productCategory",
       "businessModel",
       "icpDefinition",
       "coreProblem",
       "messagingPillars",
       "keyDifferentiators",
       "competitiveLandscape",
       "whyAlternativesFallShort",
       "customerLanguage",
       "proofPoints",
       "activeHypotheses",
       "brandVoice",
       "wordsToUse",
       "wordsToAvoid"
      ]
     },
     "description": "Field name \u2192 new value pairs to apply (only valid context field names accepted)"
    },
    "change_summary": {
     "type": "string",
     "description": "What changed and why (shown in version history)"
    }
   },
   "required": [
    "updates",
    "change_summary"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  }
 },
