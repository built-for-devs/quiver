 {
  "name": "create_campaign",
  "inputSchema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string",
     "description": "Campaign name"
    },
    "description": {
     "type": "string",
     "description": "Campaign description"
    },
    "goal": {
     "type": "string",
     "description": "Campaign goal"
    },
    "channels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Marketing channels"
    },
    "priority": {
     "type": "string",
     "enum": [
      "high",
      "medium",
      "low"
     ],
     "default": "medium",
     "description": "Campaign priority"
    },
    "start_date": {
     "type": "string",
     "description": "Start date (ISO format)"
    },
    "end_date": {
     "type": "string",
     "description": "End date (ISO format)"
    }
   },
   "required": [
    "name"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  }
 },
 {
  "name": "create_task",
  "inputSchema": {
   "type": "object",
   "properties": {
    "title": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300,
     "description": "Short imperative task title"
    },
    "description": {
     "type": "string",
     "maxLength": 5000,
     "description": "Details, acceptance criteria, or context"
    },
    "priority": {
     "type": "string",
     "enum": [
      "high",
      "medium",
      "low"
     ],
     "description": "high, medium (default) or low"
    },
    "due_date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "description": "Due date as YYYY-MM-DD (end of that day, UTC)"
    },
    "assignee_id": {
     "type": "string",
     "description": "Clerk user id of the owner"
    },
    "campaign_id": {
     "type": "string",
     "description": "Campaign ID to link"
    },
    "campaign_name": {
     "type": "string",
     "description": "Campaign name (partial match) when no campaign_id"
    },
    "artifact_id": {
     "type": "string",
     "description": "Artifact ID to link"
    },
    "artifact_title": {
     "type": "string",
     "description": "Artifact title (partial match) when no artifact_id"
    },
    "content_piece_id": {
     "type": "string",
     "description": "Content piece ID to link"
    },
    "research_entry_id": {
     "type": "string",
     "description": "Research entry ID to link"
    },
    "session_id": {
     "type": "string",
     "description": "Session ID this task came from"
    }
   },
   "required": [
    "title"
   ],
   "additionalProperties": false,
   "$schema": "http://json-schema.org/draft-07/schema#"
  }
 },
