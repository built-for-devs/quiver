       },
       "current": {
        "type": "string",
        "description": "Current value as string (for the reviewer's context)"
       },
       "proposed": {
        "description": "The COMPLETE new value for the field, which REPLACES the current value entirely on approval (type must match the field). Not a fragment, a diff or text to append \u2014 anything omitted here is erased from the field."
       },
       "rationale": {
        "type": "string",
        "description": "Why this change is being proposed"
       }
      },
      "required": [
       "field",
       "current",
       "rationale"
      ],
      "additionalProperties": false
     },
     "description": "Array of field-level proposals"
    },
